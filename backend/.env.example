# Copy to .env on the server (this file is a template; .env is gitignored)
DB_SERVER=147.93.155.21
DB_USER=Sa
DB_PASSWORD=Mind56%^
DB_NAME=T_EHRSaravanaClinic
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
MAIL_ENCRYPTION_KEY=change-this-to-a-long-random-string

# Google Drive Folder Access (Settings > Mail Configuration). Create these in
# Google Cloud Console: OAuth 2.0 Client ID (Web application), with
# GOOGLE_REDIRECT_URI added as an authorized redirect URI exactly as below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smartclinic.thangaminfotech.com/api/drive-config/oauth/callback

# Patient Records (Doctor's/Reports > Patient Records, and the Patient login
# portal) — currently backed by Cloudinary; Google Drive support (below)
# stays wired up dormant to switch back to later. Get these 3 values from
# your Cloudinary Dashboard homepage (cloudinary.com/console) after signing
# in — no file to download, just copy-paste.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dormant until Patient Records switches back to Google Drive. A single
# service-account connection to your Drive — no OAuth consent flow. In Google
# Cloud Console: create a Service Account, download its JSON key (paste the
# whole thing below as one line), enable the Drive API, then in Google Drive
# share the destination folder with the service account's email (Editor
# access) and put that folder's ID below.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
